# OpenAI API Key (Required for AI analysis: PR review, issue triage, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Personal Access Token (Required for private repos or increased rate limits)
# Can also be set in GitHub Actions via secrets.GITHUB_TOKEN
GITHUB_TOKEN=your_github_token_here

# Optional: Override OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: Base URL for OpenAI compatible proxies or self-hosted LLMs
# OPENAI_BASE_URL=https://api.openai.com/v1
